{
  "version": 1,
  "author": "Reyhan Maulana",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht1", "top": -110, "left": 120, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": 40, "left": -110, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 120, "left": -110, "attrs": { "value": "220" } },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 140, "left": 120, "attrs": { "color": "green" } }
